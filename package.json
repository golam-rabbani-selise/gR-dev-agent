{
  "name": "gr-dev-agent",
  "version": "0.1.0",
  "description": "gR DEV AGENT \u2014 AI engineering, orchestrated. A vendor-neutral, parallel multi-agent engineering workflow orchestrator. The repository owns the workflow; AI tools are only workers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gr-agent": "./dist/index.js",
    "gra": "./dist/index.js"
  },
  "files": [
    "dist",
    "integrations.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.2",
    "ink": "^5.2.1",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.31",
    "eslint": "^9.17.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
