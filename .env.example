# Native worker LLM provider credentials / endpoints.
# Set only what you use. The native worker never depends on Claude/Codex/Cursor CLIs.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=

# Ollama (local, no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
